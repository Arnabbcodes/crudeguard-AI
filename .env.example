# Supabase Credentials (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Groq API Key (Used by Supabase Edge Functions or Local AI proxy)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Supabase Edge Functions Base URL (Local dev or hosted)
# Hosted format: https://your-project-ref.supabase.co/functions/v1
# Local format: http://127.0.0.1:54321/functions/v1
SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1
